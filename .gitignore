.venv/
__pycache__/
*.pyc
*.egg-info/
# The OCR-aligned corpus is tracked: 4.6 MB, and it is the input to Phase 3.
# Rebuilding it needs Tesseract and 1-2 hours, which would make the Colab
# training cells unrunnable from a clean clone. Everything else under data/
# stays out.
data/*
!data/processed/
data/processed/*
!data/processed/*.jsonl
# Weights stay out - a LayoutLMv3 checkpoint is ~500 MB. The numbers a run
# produced do not: metrics.csv is the training curve and results.md is the
# scored table, and both are evidence the README cites.
outputs/*
!outputs/*/
outputs/*/*
!outputs/*/metrics.csv
!outputs/*/best/
outputs/*/best/*
!outputs/*/best/selection.json
!outputs/*/best/results.md
checkpoints/
.ipynb_checkpoints/
wandb/
.env
.hf_cache/

# Regenerated in the repo root by scripts/test_crop.py and test_crop2.py.
# The README figures live in docs/ and are tracked.
/crop_before.png
/crop_after.png
/crop2_after.png